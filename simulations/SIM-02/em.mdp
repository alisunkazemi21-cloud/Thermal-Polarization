; em.mdp — SIM-01 energy minimization
; GROMACS 2025.4
; Purpose: remove bad contacts from the gmx-solvate output before any
; dynamics are run. Steepest-descent minimization is used, NOT
; integrator = md, because forcing an MD integrator onto a raw solvated
; configuration risks a numerically unstable first step.

integrator               = steep
emtol                    = 1000.0      ; kJ/mol/nm — [INFERRED] common convergence criterion
emstep                   = 0.01        ; nm, initial step size
nsteps                   = 50000       ; maximum steps; minimization may finish earlier via emtol

; Neighbor searching
cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.0
pbc                      = xyz

; Electrostatics
coulombtype              = PME
rcoulomb                 = 1.0

; Van der Waals
rvdw                     = 1.0
DispCorr                 = EnerPres   ; [INFERRED] standard long-range dispersion correction

; Constraints — SETTLE is applied via the topology regardless; h-bonds is
; kept here only for consistency with the rest of the project's mandated
; settings and is otherwise inert for this fully SETTLE-constrained water.
constraints               = h-bonds
constraint-algorithm      = lincs

; Output
nstxout                   = 0
nstvout                   = 0
nstenergy                 = 100
nstlog                    = 100
