; nemd-production.mdp — SIM-02, NEMD production
; GROMACS 2025.4
; Continues from nemd-startup's final checkpoint. 1.5 ns provisional
; production length — extend if T(z)/rho(z)/Pz(z) have not stabilized.
; Same thermostat/pressure configuration as nemd-startup.mdp.

integrator                = md
dt                        = 0.002
nsteps                    = 750000      ; 750000 * 0.002 ps = 1500 ps

cutoff-scheme             = Verlet
nstlist                   = 10
rlist                     = 1.0
pbc                       = xyz

coulombtype               = PME
rcoulomb                  = 1.0
rvdw                      = 1.0
DispCorr                  = EnerPres

constraints               = h-bonds
constraint-algorithm      = lincs
lincs_iter                = 1
lincs_order               = 4

tcoupl                    = V-rescale
tc-grps                   = Hot   Cold  Rest
tau_t                     = 0.5   0.5   5.0
ref_t                     = 320   280   300

pcoupl                    = no

continuation              = yes
gen_vel                   = no

; Denser sampling than SIM-01 production — spatial profiles need more
; frames to bin well
nstxout                   = 0
nstvout                   = 0
nstfout                   = 0
nstxout-compressed        = 250      ; every 0.5 ps
compressed-x-grps         = System
nstenergy                 = 250
nstlog                    = 500
