; md-nvt-diffusion.mdp — SIM-01 supplementary NVT leg (Option B, addendum)
; GROMACS 2025.4
; Purpose: fixed-volume continuation from the end of the NPT production
; run (md.gro / md.cpt), used ONLY for a cleaner self-diffusion estimate.
; Density/RDF validation already comes from the NPT production run —
; this leg exists solely to remove NPT volume-fluctuation noise from MSD.
;
; [LIMITATION] The fixed box here is whatever the instantaneous box was
; at the final frame of production (t = 1000 ps), not the true
; time-averaged NPT volume. State this in the validation report.

integrator                  = md
dt                          = 0.002
nsteps                      = 500000    ; 500000 * 0.002 ps = 1000 ps = 1 ns

; Neighbor searching
cutoff-scheme               = Verlet
nstlist                     = 10
rlist                       = 1.0
pbc                         = xyz

; Electrostatics
coulombtype                 = PME
rcoulomb                    = 1.0

; Van der Waals
rvdw                        = 1.0
DispCorr                    = EnerPres

; Constraints
constraints                 = h-bonds
constraint-algorithm        = lincs
lincs_iter                  = 1
lincs_order                 = 4

; Temperature coupling — same as production
tcoupl                      = V-rescale
tc-grps                     = System
tau_t                       = 0.1
ref_t                       = 300

; Pressure coupling — OFF. This is the entire purpose of this leg.
pcoupl                      = no

; Continuation from the end of production — carry over velocities/state
continuation                = yes
gen_vel                     = no

; Output — same cadence as production, for a comparable MSD fit window
nstxout                     = 0
nstvout                     = 0
nstfout                     = 0
nstxout-compressed          = 500      ; every 1 ps
compressed-x-grps           = System
nstenergy                   = 500
nstlog                      = 500
