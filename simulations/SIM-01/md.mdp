; md.mdp — SIM-01 production MD
; GROMACS 2025.4
; Purpose: 1 ns production run at 300 K / 1 bar for density, O-O RDF,
; and self-diffusion validation against SPC/E literature values.
;
; [OPEN — FLAGGED FOR USER CONFIRMATION, not silently decided]
; Keeping pcoupl = Parrinello-Rahman during production is required to
; validate the DENSITY target at 1 bar (a locked SIM-01 validation
; target). However, NPT volume fluctuations can add noise to a
; self-diffusion estimate from MSD, which is ideally computed at fixed
; volume (NVT). Two options:
;   (a) [DEFAULT USED BELOW] Run production in NPT. Use it for density
;       and RDF validation, and report the diffusion coefficient as
;       provisional/NPT-derived, with this caveat stated in the
;       validation report.
;   (b) Add a second, NVT-only production leg (fixed volume, taken from
;       the NPT-equilibrated average box) purely for a cleaner diffusion
;       estimate. NOT created here — requires explicit approval, since
;       it is an additional simulation stage beyond what Checkpoint 01
;       specifies.
; Proceeding with (a) unless you tell me to add (b).

integrator                  = md
dt                           = 0.002
nsteps                       = 500000    ; 500000 * 0.002 ps = 1000 ps = 1 ns

; Neighbor searching
cutoff-scheme                = Verlet
nstlist                      = 10
rlist                        = 1.0
pbc                          = xyz

; Electrostatics
coulombtype                  = PME
rcoulomb                     = 1.0

; Van der Waals
rvdw                         = 1.0
DispCorr                     = EnerPres

; Constraints
constraints                  = h-bonds
constraint-algorithm         = lincs
lincs_iter                   = 1
lincs_order                  = 4

; Temperature coupling
tcoupl                       = V-rescale
tc-grps                      = System
tau_t                        = 0.1
ref_t                        = 300

; Pressure coupling — see [OPEN] note above before running
pcoupl                       = Parrinello-Rahman
pcoupltype                   = isotropic
tau_p                        = 2.0
ref_p                        = 1.0
compressibility              = 4.5e-5

; Continuation from NPT
continuation                 = yes
gen_vel                      = no

; Output — no full .trr needed; compressed .xtc is sufficient for
; density/RDF/diffusion analysis and keeps file size manageable.
nstxout                      = 0
nstvout                      = 0
nstfout                      = 0
nstxout-compressed           = 500      ; every 1 ps
compressed-x-grps            = System
nstenergy                    = 500
nstlog                       = 500
