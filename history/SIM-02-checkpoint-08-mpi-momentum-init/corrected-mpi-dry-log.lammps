  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.004 seconds
  read_data CPU = 4.501 seconds

group           oxygen type 2
4500 atoms in group oxygen
group           hydrogen type 1
9000 atoms in group hydrogen

pair_style      lj/cut/coul/long 11.0 18.176715436271188
pair_coeff      1 1 0.0 0.0
pair_coeff      1 2 0.0 0.0
pair_coeff      2 2 0.15535 3.166
pair_modify     tail yes
kspace_style    pppm 1.0e-5

bond_style      harmonic
bond_coeff      1 1000.0 1.0
angle_style     harmonic
angle_coeff     1 100.0 109.47

neighbor        4.0 bin
neigh_modify    one 7500
timestep        1.0
reset_timestep  0

variable        out string /tmp/sim02-gate2-mpi-dry
variable        seed equal 20260930

compute         bridge_temp all temp
compute         bridge_pressure all pressure bridge_temp
variable        vcomx equal vcm(all,x)
variable        vcomy equal vcm(all,y)
variable        vcomz equal vcm(all,z)

thermo_style    custom step time atoms temp press pe ke etotal vol lx ly lz v_vcomx v_vcomy v_vcomz
thermo_modify   temp bridge_temp press bridge_pressure flush yes
thermo          1000
restart         50000 ${out}/restart.1 ${out}/restart.2
restart         50000 /tmp/sim02-gate2-mpi-dry/restart.1 ${out}/restart.2
restart         50000 /tmp/sim02-gate2-mpi-dry/restart.1 /tmp/sim02-gate2-mpi-dry/restart.2

dump            bridge_frames all custom/gz 10000 ${out}/bridge-*.lammpstrj.gz id mol type x y z vx vy vz
dump            bridge_frames all custom/gz 10000 /tmp/sim02-gate2-mpi-dry/bridge-*.lammpstrj.gz id mol type x y z vx vy vz
dump_modify     bridge_frames sort id

print           "SIM02_GATE2 seed=${seed} timestep_fs=1 warmup_ps=20 nvt_ps=500 nve_ps=1000"
SIM02_GATE2 seed=20260930 timestep_fs=1 warmup_ps=20 nvt_ps=500 nve_ps=1000
print           "SIM02_GATE2 fixed_box=yes ehex=no"
SIM02_GATE2 fixed_box=yes ehex=no

# The imported file is a NEMD state. Do not retain its velocity field.
velocity        all create 400.0 ${seed} mom yes rot yes dist gaussian
velocity        all create 400.0 20260930 mom yes rot yes dist gaussian

# Stage A: explicit operational translation of the paper's 20 ps velocity
# rescaling. The paper does not report its cadence; 100 fs is frozen here.
fix             integrate all nve
fix             constraints all rattle 1.0e-10 400 0 b 1 a 1
Finding RATTLE clusters ...
       0 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
    4500 = # of frozen angles
  find clusters CPU = 0.031 seconds
# Initialize RATTLE before the final momentum removal. Parallel constraint
# initialization can otherwise leave a small resolved COM velocity.
run             0 post no
