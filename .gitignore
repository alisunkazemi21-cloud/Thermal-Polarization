# Large regenerable GROMACS binary output — reproducible from .mdp/.top + commands
*.trr
*.edr
*.cpt
*.tpr
*.xtc
*.log

# GROMACS auto-generated / backup artifacts
mdout.mdp
"#*#"

# GROMACS energy output — raw text, kept ignored in favor of the derived .csv summaries
*.xvg

# MDAnalysis trajectory index cache
*_offsets.lock
*_offsets.npz

# Python
__pycache__/
*.pyc
.venv/

notebooks/__marimo__/
docs/CLAUDE.md

# SIM-02 checkpoint trajectories and restarts; preserve only compact evidence.
results/raw/SIM-02/checkpoint-08-equilibrium/*
!results/raw/SIM-02/checkpoint-08-equilibrium/README.md
!results/raw/SIM-02/checkpoint-08-equilibrium/dry-run-stdout.txt
!results/raw/SIM-02/checkpoint-08-equilibrium/dry-run-log.lammps
!results/raw/SIM-02/checkpoint-08-equilibrium/run-start.json
results/raw/SIM-02/checkpoint-09-diagnostics/*
!results/raw/SIM-02/checkpoint-09-diagnostics/README.md
!results/raw/SIM-02/checkpoint-09-diagnostics/checkpoint-09-summary.json

# Graphify machine-local interpreter paths, extraction scratch, and caches
graphify-out/.*
graphify-out/cache/
graphify-out/20*/
