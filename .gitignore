# Large regenerable GROMACS binary output — reproducible from .mdp/.top + commands
*.trr
*.edr
*.cpt
*.tpr
*.xtc
*.log

# GROMACS auto-generated / backup artifacts
mdout.mdp
"#*#"

# GROMACS energy output — raw text, kept ignored in favor of the derived .csv summaries
*.xvg

# MDAnalysis trajectory index cache
*_offsets.lock
*_offsets.npz

# Python
__pycache__/
*.pyc
.venv/

notebooks/__marimo__/
docs/CLAUDE.md

# SIM-02 checkpoint trajectories and restarts; preserve only compact evidence.
results/raw/SIM-02/checkpoint-08-equilibrium/*
!results/raw/SIM-02/checkpoint-08-equilibrium/README.md
!results/raw/SIM-02/checkpoint-08-equilibrium/dry-run-stdout.txt
!results/raw/SIM-02/checkpoint-08-equilibrium/dry-run-log.lammps
!results/raw/SIM-02/checkpoint-08-equilibrium/run-start.json
results/raw/SIM-02/checkpoint-09-diagnostics/*
!results/raw/SIM-02/checkpoint-09-diagnostics/README.md
!results/raw/SIM-02/checkpoint-09-diagnostics/checkpoint-09-summary.json
!results/raw/SIM-02/checkpoint-09-diagnostics/sha256-manifest.json
results/raw/SIM-02/checkpoint-10-single-rank-nve/*
!results/raw/SIM-02/checkpoint-10-single-rank-nve/README.md
!results/raw/SIM-02/checkpoint-10-single-rank-nve/checkpoint-10-summary.json
!results/raw/SIM-02/checkpoint-10-single-rank-nve/run-metadata.json
!results/raw/SIM-02/checkpoint-10-single-rank-nve/sha256-manifest.json
results/raw/SIM-02/checkpoint-11-same-restart-one-rank/*
!results/raw/SIM-02/checkpoint-11-same-restart-one-rank/README.md
!results/raw/SIM-02/checkpoint-11-same-restart-one-rank/checkpoint-11-summary.json
!results/raw/SIM-02/checkpoint-11-same-restart-one-rank/run-metadata.json
!results/raw/SIM-02/checkpoint-11-same-restart-one-rank/sha256-manifest.json

